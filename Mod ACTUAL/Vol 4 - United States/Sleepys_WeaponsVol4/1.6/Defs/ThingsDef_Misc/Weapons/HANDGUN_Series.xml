  <!-- Keltec CP33 -->
  <ThingDef ParentName="SLPBaseGunWithQuality">
    <defName>SLP_Gun_USA_KeltecCP33_S</defName>
    <label>Keltec CP33</label>
    <description>A short recoil–operated, semi-automatic pistol. Handles exceptionally well, requires little maintenance and is quick. Lacks the range, accuracy or firepower for long range combat.</description>
	<graphicData>
      <texPath>Things/Item/Equipment/Handguns/SLP_USA_KELTECCP33_S</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <soundInteract>SLP_HKUSPInter</soundInteract>
    <weaponTags>
      <li>SimpleGun</li>
      <li>Autopistol</li>
    </weaponTags>
    <weaponClasses>
      <li>RangedLight</li>
    </weaponClasses>
    <thingSetMakerTags><li>RewardStandardQualitySuper</li></thingSetMakerTags>
    <statBases>
	  <MarketValue>110</MarketValue>
      <Mass>0.83</Mass>
      <AccuracyTouch>0.80</AccuracyTouch>
      <AccuracyShort>0.61</AccuracyShort>
      <AccuracyMedium>0.31</AccuracyMedium>
      <AccuracyLong>0.20</AccuracyLong>
      <RangedWeapon_Cooldown>0.48</RangedWeapon_Cooldown>
    </statBases>
    <costList>
      <Steel>35</Steel>
      <ComponentIndustrial>3</ComponentIndustrial>
    </costList>
    <verbs>
      <li>
        <verbClass>Verb_Shoot</verbClass>
        <hasStandardCommand>true</hasStandardCommand>
        <defaultProjectile>Bullet_KeltecCP33_S</defaultProjectile>
        <warmupTime>0.3</warmupTime>
        <range>20.9</range>
        <soundCast>SLP_HKUSPShot</soundCast>
        <soundCastTail>GunTail_Light</soundCastTail>
        <muzzleFlashScale>9</muzzleFlashScale>
      </li>
    </verbs>
    <tools>
      <li>
        <label>grip</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>8</power>
        <cooldownTime>1.9</cooldownTime>
      </li>
      <li>
        <label>barrel</label>
        <capacities>
          <li>Blunt</li>
          <li>Poke</li>
        </capacities>
        <power>8</power>
        <cooldownTime>1.9</cooldownTime>
      </li>
    </tools>
  </ThingDef>
  
