  <ThingDef ParentName="SLPBaseGunWithQuality">
    <defName>SLP_Gun_USA_AR57_S</defName>
    <label>AR57</label>
    <description>A general-purpose gas-operated assault rifle for field or urban combat. It has good range, decent power, and good accuracy.</description>
    <graphicData>
      <texPath>Things/Item/Equipment/Rifles/SLP_USA_AR57_S</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
	
	<equippedAngleOffset>-45</equippedAngleOffset>
	
    <soundInteract>SLP_M4Inter</soundInteract>
    <weaponTags>
      <li>IndustrialGunAdvanced</li>
      <li>AssaultRifle</li>
    </weaponTags>
	<!--
    <weaponClasses>
      <li>RangedHeavy</li>
    </weaponClasses>
	-->
	<!--
    <recipeMaker>
      <researchPrerequisite>PrecisionRifling</researchPrerequisite>
      <skillRequirements>
        <Crafting>6</Crafting>
      </skillRequirements>
    </recipeMaker>
	-->
    <thingSetMakerTags><li>RewardStandardQualitySuper</li></thingSetMakerTags>
    <statBases>
	  <MarketValue>437</MarketValue>
      <!--<WorkToMake>40000</WorkToMake>-->
      <Mass>3.4</Mass>
      <AccuracyTouch>0.75</AccuracyTouch>
      <AccuracyShort>0.70</AccuracyShort>
      <AccuracyMedium>0.55</AccuracyMedium>
      <AccuracyLong>0.42</AccuracyLong>
      <RangedWeapon_Cooldown>1.70</RangedWeapon_Cooldown>
    </statBases>

    <costList>
      <Steel>60</Steel>
      <ComponentIndustrial>7</ComponentIndustrial>
    </costList>

    <verbs>
      <li>
        <verbClass>Verb_Shoot</verbClass>
        <hasStandardCommand>true</hasStandardCommand>
        <defaultProjectile>SLP_Bullet_AR57_S</defaultProjectile>
        <warmupTime>1.00</warmupTime>
        <range>25.9</range>
		<burstShotCount>4</burstShotCount>
        <ticksBetweenBurstShots>4</ticksBetweenBurstShots> <!-- 1200RPM=3, 900RPM=4, 720RPM=5, 600RPM=6, 512.29RPM=7, 450RPM=8, 400RPM=9, 360RPM=10, 327.27RPM=11, 300RPM=12, 240RPM=15-->
