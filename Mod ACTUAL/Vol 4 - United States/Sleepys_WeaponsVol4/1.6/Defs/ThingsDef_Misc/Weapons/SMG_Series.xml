  <!-- ================================= MACHINE PISTOL ==================================== -->
  <!-- CMR30-->
  <ThingDef ParentName="SLPBaseGunWithQuality">
    <defName>SLP_Gun_USA_CMR30_S</defName>
    <label>CMR30</label>
    <description>A ancient style machine pistol. Handles exceptionally well, is robust and is somewhat accurate and quick in close quarter battles. Lacks the range, accuracy or firepower for long range combat.</description>
    <graphicData>
      <texPath>Things/Item/Equipment/SMG/SLP_USA_CMR30_S</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
	

	<equippedAngleOffset>-45</equippedAngleOffset>

	
    <soundInteract>SLP_SMG_GenericInter</soundInteract>
	
    <weaponClasses>
      <li>ShortShots</li>
      <li>RangedLight</li>
    </weaponClasses>
	<!--
    <recipeMaker>
      <researchPrerequisite>GasOperation</researchPrerequisite>
      <skillRequirements>
        <Crafting>5</Crafting>
      </skillRequirements>
    </recipeMaker>
	-->
    <thingSetMakerTags><li>RewardStandardQualitySuper</li></thingSetMakerTags>
    <statBases>
      <!-- <WorkToMake>26000</WorkToMake> -->
	  <MarketValue>219</MarketValue>
      <Mass>2.50</Mass>
      <AccuracyTouch>0.85</AccuracyTouch>
      <AccuracyShort>0.75</AccuracyShort>
      <AccuracyMedium>0.35</AccuracyMedium>
      <AccuracyLong>0.15</AccuracyLong>
      <RangedWeapon_Cooldown>0.90</RangedWeapon_Cooldown>
    </statBases>
	
    <costList>
      <Steel>55</Steel>
      <ComponentIndustrial>3</ComponentIndustrial>
    </costList>
	
    <verbs>
      <li>
        <verbClass>Verb_Shoot</verbClass>
        <hasStandardCommand>true</hasStandardCommand>
        <defaultProjectile>SLP_Bullet_CMR30_S</defaultProjectile>
        <warmupTime>0.30</warmupTime>
        <range>21.9</range>
        <burstShotCount>3</burstShotCount>
        <ticksBetweenBurstShots>7</ticksBetweenBurstShots> 
		<!-- 1200RPM=3, 900RPM=4, 720RPM=5, 600RPM=6, 512.29RPM=7, 450RPM=8, 400RPM=9, 360RPM=10, 327.27RPM=11, 300RPM=12, 240RPM=15-->
		<soundCast>SLP_SMG_PP19Shot</soundCast>
        <soundCastTail>GunTail_Light</soundCastTail>
        <muzzleFlashScale>9</muzzleFlashScale>
      </li>
    </verbs>
    <weaponTags>
	  <li>ShortShots</li>
    </weaponTags>
    <tools>
      <li>
        <label>grip</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>9</power>
        <cooldownTime>2</cooldownTime>
      </li>
      <li>
        <label>barrel</label>
        <capacities>
          <li>Blunt</li>
          <li>Poke</li>
        </capacities>
        <power>9</power>
        <cooldownTime>2</cooldownTime>
      </li>
    </tools>
  </ThingDef>
  
