  <!-- ================================= Weapons ==================================== -->
  <!-- M870 -->
  <ThingDef ParentName="BaseHumanMakeableGun">
    <defName>SLP_Gun_USA_M870_S</defName>
    <label>M870</label>
    <description>An ancient design of shotgun that emits a tight-packed spray of pellets. Deadly, but short range.</description>
    <graphicData>
      <texPath>Things/Item/Equipment/Shotguns/SLP_USA_M870_S</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
	
	<equippedAngleOffset>-45.0</equippedAngleOffset>
	
    <soundInteract>SLP_ShotgunPumpInter</soundInteract>
	
    <weaponClasses>
      <li>ShortShots</li>
    </weaponClasses>
	
    <statBases>
	  <MarketValue>263</MarketValue>
      <WorkToMake>12000</WorkToMake>
      <Mass>3.4</Mass>
      <AccuracyTouch>0.85</AccuracyTouch>
      <AccuracyShort>0.85</AccuracyShort>
      <AccuracyMedium>0.74</AccuracyMedium>
      <AccuracyLong>0.61</AccuracyLong>
      <RangedWeapon_Cooldown>1.2</RangedWeapon_Cooldown>
    </statBases>
	
    <costList>
      <Steel>60</Steel>
      <ComponentIndustrial>3</ComponentIndustrial>
    </costList>
	
    <recipeMaker>
	  <researchPrerequisite>SLP_AdvLR</researchPrerequisite>
      <skillRequirements>
        <Crafting>5</Crafting>
      </skillRequirements>
    </recipeMaker>
	
    <verbs>
      <li>
        <verbClass>Verb_Shoot</verbClass>
        <hasStandardCommand>true</hasStandardCommand>
        <defaultProjectile>SLP_Bullet_M870_S</defaultProjectile>
        <warmupTime>1.0</warmupTime>
        <range>16.9</range>
        <soundCast>SLP_SHOTGUN_M870Shot</soundCast>
        <soundCastTail>GunTail_Heavy</soundCastTail>
        <muzzleFlashScale>9</muzzleFlashScale>
      </li>
    </verbs>
	
    <tools>
      <li>
        <label>stock</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>9</power>
        <cooldownTime>2</cooldownTime>
      </li>
      <li>
        <label>barrel</label>
        <capacities>
          <li>Blunt</li>
          <li>Poke</li>
        </capacities>
        <power>9</power>
        <cooldownTime>2</cooldownTime>
      </li>
    </tools>
  </ThingDef>
  
